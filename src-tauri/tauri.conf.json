{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emty Agent",
  "version": "0.1.0",
  "identifier": "com.emty",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emty Agent",
        "width": 975,
        "height": 540,
        "minWidth": 1140,
        "minHeight": 540,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "desktop-capability",
        "browser-remote"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
