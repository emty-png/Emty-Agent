{
    "identifier":  "desktop-capability",
    "platforms":  [
                      "macOS",
                      "windows",
                      "linux"
                  ],
    "windows":  [
                    "main"
                ],
    "permissions":  [
                        "window-state:default",
                        {
                            "identifier":  "http:default",
                            "allow":  [
                                          {
                                              "url":  "https://**"
                                          },
                                          {
                                              "url":  "http://**"
                                          }
                                      ]
                        },
                        "updater:default",
                        "process:default"
                    ]
}
