{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "window-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-browser-mount-surface",
    "allow-browser-resize-surface",
    "allow-browser-unmount-surface",
    "allow-browser-close-surface",
    "allow-browser-surface-navigate",
    "allow-browser-surface-reload",
    "allow-browser-surface-screenshot",
    "allow-browser-surface-dispatch",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "allow-glob-search",
    "allow-grep-search",
    "allow-ddg-search",
    "core:window:allow-scale-factor",
    "fs:read-all",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file-lines",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "C:\\Program Files\\Git\\bin\\bash.exe"
        },
        {
          "path": "C:\\Program Files\\Git\\usr\\bin\\bash.exe"
        },
        {
          "path": "C:\\Program Files\\Git\\git-bash.exe"
        },
        {
          "path": "C:\\Program Files (x86)\\Git\\bin\\bash.exe"
        },
        {
          "path": "C:\\Program Files (x86)\\Git\\usr\\bin\\bash.exe"
        },
        {
          "path": "C:\\Program Files (x86)\\Git\\git-bash.exe"
        },
        {
          "path": "$HOME/.emty/**"
        },
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/.emty/**"
        }
      ]
    },
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:allow-listen",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": true
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "pwsh",
          "cmd": "pwsh",
          "args": true
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "git-bash",
          "cmd": "C:\\Program Files\\Git\\bin\\bash.exe",
          "args": true
        },
        {
          "name": "git-bash-x86",
          "cmd": "C:\\Program Files (x86)\\Git\\bin\\bash.exe",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": true
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "pwsh",
          "cmd": "pwsh",
          "args": true
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "git-bash",
          "cmd": "C:\\Program Files\\Git\\bin\\bash.exe",
          "args": true
        },
        {
          "name": "git-bash-x86",
          "cmd": "C:\\Program Files (x86)\\Git\\bin\\bash.exe",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    }
  ]
}
