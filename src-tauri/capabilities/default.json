{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "allow-browser-mount-surface",
    "allow-browser-resize-surface",
    "allow-browser-unmount-surface",
    "allow-browser-close-surface",
    "allow-browser-surface-navigate",
    "allow-browser-surface-reload",
    "allow-browser-surface-screenshot",
    "allow-browser-surface-dispatch",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "core:window:allow-scale-factor",
    "fs:read-all",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:allow-listen",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "powershell", "cmd": "powershell.exe", "args": true },
        { "name": "pwsh",       "cmd": "pwsh",           "args": true },
        { "name": "cmd",        "cmd": "cmd.exe",         "args": true },
        { "name": "bash",       "cmd": "bash",            "args": true },
        { "name": "sh",         "cmd": "sh",              "args": true },
        { "name": "zsh",        "cmd": "zsh",             "args": true },
        { "name": "git",        "cmd": "git",             "args": true },
        { "name": "node",       "cmd": "node",            "args": true },
        { "name": "node-exe",   "cmd": "node.exe",        "args": true },
        { "name": "npm",        "cmd": "npm",             "args": true },
        { "name": "npm-cmd",    "cmd": "npm.cmd",         "args": true },
        { "name": "npx",        "cmd": "npx",             "args": true },
        { "name": "npx-cmd",    "cmd": "npx.cmd",         "args": true },
        { "name": "pnpm",       "cmd": "pnpm",            "args": true },
        { "name": "pnpm-cmd",   "cmd": "pnpm.cmd",        "args": true },
        { "name": "yarn",       "cmd": "yarn",            "args": true },
        { "name": "yarn-cmd",   "cmd": "yarn.cmd",        "args": true },
        { "name": "python",     "cmd": "python",          "args": true },
        { "name": "python-exe", "cmd": "python.exe",      "args": true },
        { "name": "py",         "cmd": "py",              "args": true },
        { "name": "py-exe",     "cmd": "py.exe",          "args": true },
        { "name": "uv",         "cmd": "uv",              "args": true },
        { "name": "uvx",        "cmd": "uvx",             "args": true },
        { "name": "bun",        "cmd": "bun",             "args": true },
        { "name": "bunx",       "cmd": "bunx",            "args": true },
        { "name": "deno",       "cmd": "deno",            "args": true }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "powershell", "cmd": "powershell.exe", "args": true },
        { "name": "pwsh",       "cmd": "pwsh",           "args": true },
        { "name": "cmd",        "cmd": "cmd.exe",         "args": true },
        { "name": "bash",       "cmd": "bash",            "args": true },
        { "name": "sh",         "cmd": "sh",              "args": true },
        { "name": "zsh",        "cmd": "zsh",             "args": true },
        { "name": "git",        "cmd": "git",             "args": true },
        { "name": "node",       "cmd": "node",            "args": true },
        { "name": "node-exe",   "cmd": "node.exe",        "args": true },
        { "name": "npm",        "cmd": "npm",             "args": true },
        { "name": "npm-cmd",    "cmd": "npm.cmd",         "args": true },
        { "name": "npx",        "cmd": "npx",             "args": true },
        { "name": "npx-cmd",    "cmd": "npx.cmd",         "args": true },
        { "name": "pnpm",       "cmd": "pnpm",            "args": true },
        { "name": "pnpm-cmd",   "cmd": "pnpm.cmd",        "args": true },
        { "name": "yarn",       "cmd": "yarn",            "args": true },
        { "name": "yarn-cmd",   "cmd": "yarn.cmd",        "args": true },
        { "name": "python",     "cmd": "python",          "args": true },
        { "name": "python-exe", "cmd": "python.exe",      "args": true },
        { "name": "py",         "cmd": "py",              "args": true },
        { "name": "py-exe",     "cmd": "py.exe",          "args": true },
        { "name": "uv",         "cmd": "uv",              "args": true },
        { "name": "uvx",        "cmd": "uvx",             "args": true },
        { "name": "bun",        "cmd": "bun",             "args": true },
        { "name": "bunx",       "cmd": "bunx",            "args": true },
        { "name": "deno",       "cmd": "deno",            "args": true }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}
