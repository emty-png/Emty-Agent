{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "fs:read-all",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:allow-listen",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell.exe",
          "args": true,
          "sidecar": false
        },
        {
          "name": "pwsh",
          "cmd": "pwsh",
          "args": true,
          "sidecar": false
        },
        {
          "name": "cmd",
          "cmd": "cmd.exe",
          "args": true,
          "sidecar": false
        },
        {
          "name": "bash",
          "cmd": "bash",
          "args": true,
          "sidecar": false
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true,
          "sidecar": false
        },
        {
          "name": "zsh",
          "cmd": "zsh",
          "args": true,
          "sidecar": false
        },
        {
          "name": "git",
          "cmd": "git",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "os:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}